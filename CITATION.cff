    website: "https://stienhardt.com/?utm_source=github&utm_medium=citation_metadata&utm_campaign=agent_shoppable_census"
    city: "New York"
    country: "US"
version: "0.2"
date-released: "2026-09-03"
license: CC-BY-4.0
